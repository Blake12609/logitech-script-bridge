#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Logitech Script Bridge"
      VALUE "ProductName", "Logitech Script Bridge"
      VALUE "FileVersion", "1.2.0"
      VALUE "ProductVersion", "1.2.0"
      VALUE "OriginalFilename", "LogitechScriptBridge.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
